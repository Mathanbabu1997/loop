<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LOOP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/loop.css"
          asp-append-version="true" />
</head>

<body>

    <aside class="loop-sidebar">

        <div class="loop-logo">
            L<span>OO</span>P
        </div>

        <ul class="loop-nav">

            <li>
                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <span class="icon">🏠</span>
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a asp-controller="Feedback"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Feedback" ? "active" : "")">
                    <span class="icon">📥</span>
                    <span>Inbox</span>
                </a>
            </li>

            <li>
                <a asp-controller="Trends"
                   asp-action="Index">
                    <span class="icon">📊</span>
                    <span>Trends</span>
                </a>
            </li>

            <li>
                <a asp-controller="AskLoop"
                   asp-action="Index">
                    <span class="icon">🤖</span>
                    <span>Ask LOOP</span>
                </a>
            </li>

            <li>
                <a asp-controller="Reports"
                   asp-action="Index">
                    <span class="icon">📄</span>
                    <span>Reports</span>
                </a>
            </li>

            <li>
                <a asp-controller="Settings"
                   asp-action="Index">
                    <span class="icon">⚙️</span>
                    <span>Settings</span>
                </a>
            </li>

        </ul>

    </aside>


    <main class="loop-main">

        <header class="loop-topbar">

            <div class="loop-workspace">
                LOOP Technologies
            </div>

            <div class="loop-user">

                <span>Babu</span>

                <div class="loop-avatar">
                    B
                </div>

            </div>

        </header>


        <section class="loop-content">

            @RenderBody()

        </section>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>