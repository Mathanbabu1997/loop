@{
    ViewData["Title"] = "Import Feedback";
}

<div class="page-title">
    Import Feedback
</div>

<div class="page-subtitle">
    Upload customer feedback in bulk using CSV.
</div>


<div class="row">

    <div class="col-lg-8">

        <div class="loop-card">

            <div class="text-center p-5 border rounded">

                <div style="font-size:50px;">
                    📄
                </div>

                <h5 class="mt-3">
                    Upload CSV file
                </h5>

                <p class="text-muted">
                    Required columns:
                    content, channel, customer_label, created_at
                </p>

                <input type="file"
                       class="form-control mb-3"
                       accept=".csv" />

                <button class="btn btn-loop">
                    Import Feedback
                </button>

            </div>

        </div>


        <div class="loop-card">

            <div class="loop-card-title">
                Import Result
            </div>

            <div class="row">

                <div class="col-md-6">

                    <div class="stat-card">

                        <div class="stat-label">
                            Imported
                        </div>

                        <div class="stat-value positive">
                            115
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="stat-card">

                        <div class="stat-label">
                            Failed
                        </div>

                        <div class="stat-value negative">
                            5
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>