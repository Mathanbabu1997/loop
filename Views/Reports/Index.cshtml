@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center">

    <div>

        <div class="page-title">
            Voice of Customer
        </div>

        <div class="page-subtitle">
            Generate evidence-backed customer feedback reports.
        </div>

    </div>

    <button class="btn btn-loop">
        + Generate Report
    </button>

</div>


<div class="loop-card">

    <div class="row align-items-end">

        <div class="col-md-4">

            <label class="form-label">
                Reporting Period
            </label>

            <select class="form-select">

                <option>Last 7 Days</option>
                <option>Last 30 Days</option>
                <option>Last 90 Days</option>

            </select>

        </div>

        <div class="col-md-3">

            <button class="btn btn-loop">
                Generate Report
            </button>

        </div>

    </div>

</div>


<div class="loop-card">

    <h4>
        Weekly Customer Feedback Report
    </h4>

    <p class="text-muted">
        September 8 – September 15, 2026
    </p>

    <hr />


    <h5>
        Top Themes
    </h5>

    <ol>

        <li>Onboarding</li>
        <li>Billing</li>
        <li>Performance</li>

    </ol>


    <h5 class="mt-4">
        Sentiment Shift
    </h5>

    <p>
        Negative feedback increased by
        <strong>18%</strong>.
    </p>


    <h5 class="mt-4">
        Customer Voice
    </h5>

    <blockquote class="blockquote">
        "Onboarding took too long and I couldn't figure
        out how to invite my team."
    </blockquote>


    <h5 class="mt-4">
        Recommended Actions
    </h5>

    <ol>

        <li>Improve onboarding instructions.</li>
        <li>Simplify team invitation flow.</li>
        <li>Investigate performance complaints.</li>

    </ol>


    <button class="btn btn-outline-secondary mt-3">
        Export PDF
    </button>

</div>