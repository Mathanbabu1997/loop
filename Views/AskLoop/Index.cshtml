@{
    ViewData["Title"] = "Ask LOOP";
}

<div class="page-title">
    Ask LOOP
</div>

<div class="page-subtitle">
    Ask questions about your customer feedback.
</div>


<div class="chat-container">

    <div class="loop-card">

        <div class="chat-message chat-user">

            <strong>You</strong>

            <p class="mb-0 mt-2">
                What are customers saying about onboarding?
            </p>

        </div>


        <div class="chat-message chat-ai">

            <strong>🤖 LOOP</strong>

            <p class="mt-2">

                Customers are mainly reporting problems
                with onboarding instructions and inviting
                team members.

            </p>


            <hr />

            <strong>
                Sources
            </strong>

            <div class="source-item">
                • Feedback #102 — Onboarding
            </div>

            <div class="source-item">
                • Feedback #187 — Team invitations
            </div>

            <div class="source-item">
                • Feedback #241 — Setup process
            </div>

        </div>


        <div class="input-group mt-4">

            <input class="form-control"
                   placeholder="Ask LOOP anything..." />

            <button class="btn btn-loop">
                Ask
            </button>

        </div>

    </div>

</div>