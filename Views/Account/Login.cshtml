@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Login - LOOP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/loop.css" />

</head>


<body>

    <div class="auth-page">

        <div class="auth-card">

            <div class="auth-logo">
                LOOP
            </div>

            <div class="auth-subtitle">
                Customer Feedback Intelligence
            </div>


            <div class="mb-3">

                <label class="form-label">
                    Email
                </label>

                <input type="email"
                       class="form-control"
                       placeholder="you@example.com" />

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Password
                </label>

                <input type="password"
                       class="form-control"
                       placeholder="Password" />

            </div>


            <button class="btn btn-loop w-100 py-2">
                Login
            </button>


            <div class="text-center mt-4">

                Don't have an account?

                <a asp-action="Signup">
                    Create account
                </a>

            </div>

        </div>

    </div>

</body>

</html>